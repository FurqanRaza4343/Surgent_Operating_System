APP_NAME=AesthetixAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aesthetixai

# Clerk Auth
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_JWKS_URL=https://your-clerk.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_xxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# OpenAI / LLM
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o

# Mistral (low-stakes tier — see LLMService.chat's `tier` param)
MISTRAL_API_KEY=xxxx
MISTRAL_MODEL=mistral-small-latest

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+1xxxx

# WhatsApp Business API
WHATSAPP_API_TOKEN=xxxx
WHATSAPP_PHONE_NUMBER_ID=xxxx

# SendGrid / Email
SENDGRID_API_KEY=SG.xxxx
EMAIL_FROM=noreply@aesthetixai.com

# Resend (used by demo-request confirmation emails — see services/email/resend_service.py)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_SOLO=price_xxxx
STRIPE_PRICE_PRACTICE=price_xxxx

# Platform admin bootstrap — comma-separated emails. Any Clerk user signing
# in with one of these emails is auto-promoted to platform admin (see
# server/dependencies.py). Further admins are then promoted from /admin itself.
PLATFORM_ADMIN_EMAILS=you@aiaceonesolutions.com

# Standalone admin login (POST /api/v1/admin/auth/login) — username/password + JWT
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Calendar (Google)
GOOGLE_CLIENT_ID=xxxx
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REDIRECT_URI=https://api.aesthetixai.com/v1/integrations/google/callback

# Redis (for Celery)
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_BACKEND=cloudinary
UPLOAD_MAX_SIZE_MB=10
