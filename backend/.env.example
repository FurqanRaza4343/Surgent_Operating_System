APP_NAME=AesthetixAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aesthetixai

# Clerk Auth
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_JWKS_URL=https://your-clerk.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_xxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# OpenAI / LLM
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+1xxxx

# WhatsApp Business API
WHATSAPP_API_TOKEN=xxxx
WHATSAPP_PHONE_NUMBER_ID=xxxx

# SendGrid / Email
SENDGRID_API_KEY=SG.xxxx
EMAIL_FROM=noreply@aesthetixai.com

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_SOLO=price_xxxx
STRIPE_PRICE_PRACTICE=price_xxxx

# Calendar (Google)
GOOGLE_CLIENT_ID=xxxx
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REDIRECT_URI=https://api.aesthetixai.com/v1/integrations/google/callback

# Redis (for Celery)
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_BACKEND=cloudinary
UPLOAD_MAX_SIZE_MB=10
